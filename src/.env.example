APP_NAME= "mini-rag-app" # Preferred to be string or number
APP_VERSION= "0.1"

FILE_ALLOWED_TYPES= ["text/plain","application/pdf"]
FILE_MAX_SIZE= 10  # Size is in Mb
FILE_DEFAULT_CHUNCK_SIZE= 512000 # 512 Kb

MONGODB_URL= "mongodb://localhost:27007"
MONGODB_DATABASE= "mini-rag-app" 

# ========================== LLM Config ==========================
OPENAI_API_KEY= ""
COHERE_API_KEY= ""
OPENAI_API_URL= ""

GENERATION_BACKEND= "OPENAI"
GENERATION_MODEL_ID= "gpt-3.5-turbo-0125"

EMBEDDING_BACKEND= "COHERE"
EMBEDDING_MODEL_ID= "embed-multilingual-light-v3.0"
EMBEDDING_SIZE= 384

DEFAULT_INPUT_MAX_CHARACTERS= 1024
DEFAULT_GENERATION_MAX_OUTPUT_TOKENS= 200
DEFAULT_GENERATION_TEMPRATURE= 0.1

# ========================== Vector DB Config ==========================
VECTOR_DB_BACKEND= "QDRANT"
VECTOR_DB_FOLDER= "qdrant_db"
VECTOR_DB_DISTANCE_METHOD= "cosine"
